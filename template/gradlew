# SubKt's temporary Java compatibility dispatcher. The launchers under
# gradle/launchers are generated by Gradle and must remain unmodified.

die() { printf '%s\n' "ERROR: $*" >&2; exit 1; }

# Locate the checkout, including when this script is invoked through a symlink.
app_path=$0
while
    app_dir=${app_path%"${app_path##*/}"}
    [ -h "$app_path" ]
do
    link=$(ls -ld "$app_path")
    link=${link#*' -> '}
    case $link in
        /*) app_path=$link ;;
        *) app_path=$app_dir$link ;;
    esac
done
app_dir=$(cd -P "${app_dir:-./}" >/dev/null && pwd) || exit 1

if [ -n "$JAVA_HOME" ]; then
    java_cmd=$JAVA_HOME/bin/java
    # Match the stock launcher's handling of IBM JDKs on AIX.
    [ ! -x "$JAVA_HOME/jre/sh/java" ] || java_cmd=$JAVA_HOME/jre/sh/java
    [ -x "$java_cmd" ] || die "JAVA_HOME is not a valid Java installation: $JAVA_HOME"
else
    java_cmd=java
    command -v "$java_cmd" >/dev/null 2>&1 || die "Set JAVA_HOME or put Java on PATH."
fi

java_version=$("$java_cmd" -XshowSettings:properties -version 2>&1 |
    sed -n 's/^[[:space:]]*java.specification.version = //p' | tr -d '\r')
case $java_version in
    11|12|13|14|15|16) launcher=legacy ;;
    ''|*[!0-9]*) die "Could not detect a supported Java version. SubKt requires JDK 11 or newer." ;;
    *)
        [ "$java_version" -ge 17 ] || die "SubKt requires JDK 11 or newer (found Java $java_version)."
        launcher=modern ;;
esac

exec "$app_dir/gradle/launchers/gradlew-$launcher" "$@"
