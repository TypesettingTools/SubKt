@echo off
@rem SubKt's temporary Java compatibility dispatcher. The nested launchers
@rem are generated by Gradle and must remain unmodified.
setlocal EnableExtensions DisableDelayedExpansion

set JAVA_EXE=java.exe
if not defined JAVA_HOME goto detectJava
set JAVA_HOME=%JAVA_HOME:"=%
set JAVA_EXE=%JAVA_HOME%\bin\java.exe
if exist "%JAVA_EXE%" goto detectJava
1>&2 echo ERROR: JAVA_HOME is not a valid Java installation: %JAVA_HOME%
exit /b 1

:detectJava
set SUBKT_JAVA_VERSION=
@rem The outer quotes protect the redirection until the nested command runs.
for /f "tokens=1,2,3" %%a in ('""%JAVA_EXE%" -XshowSettings:properties -version 2>&1"') do if "%%a"=="java.specification.version" set "SUBKT_JAVA_VERSION=%%c"
set SUBKT_LAUNCHER=legacy
for %%v in (11 12 13 14 15 16) do if "%SUBKT_JAVA_VERSION%"=="%%v" goto launch
if not defined SUBKT_JAVA_VERSION goto unsupportedJava
for /f "delims=0123456789" %%v in ("%SUBKT_JAVA_VERSION%") do goto unsupportedJava
if %SUBKT_JAVA_VERSION% LSS 17 goto unsupportedJava
set SUBKT_LAUNCHER=modern
goto launch

:unsupportedJava
1>&2 echo ERROR: SubKt requires JDK 11 or newer. Check JAVA_HOME or PATH. Detected version: %SUBKT_JAVA_VERSION%
exit /b 1

:launch
@rem Transfer control without CALL, which would expand the user's arguments again.
"%~dp0gradle\launchers\gradlew-%SUBKT_LAUNCHER%.bat" %*
